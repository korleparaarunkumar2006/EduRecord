{
  "name": "student-details-portal",
  "version": "2.0.0",
  "description": "EduRecord — MERN Stack College Student Details Portal",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node backend/server.js",
    "server": "node backend/server.js",
    "client": "npm run dev --prefix client",
